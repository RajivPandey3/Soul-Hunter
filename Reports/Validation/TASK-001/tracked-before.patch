-
-        private void Start()
-        {
-            if (_gameOverPanel != null)
-            {
-                _gameOverPanel.SetActive(false);
-            }
-
-            if (_restartButton != null)
-            {
-                _restartButton.onClick.AddListener(RestartGame);
-            }
