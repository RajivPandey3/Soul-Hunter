-		struct vertex_t
-		{
-			UNITY_VERTEX_INPUT_INSTANCE_ID
-			float4	position		: POSITION;
-			float3	normal			: NORMAL;
-			fixed4	color			: COLOR;
-			float4	texcoord0		: TEXCOORD0;
-			float2	texcoord1		: TEXCOORD1;
