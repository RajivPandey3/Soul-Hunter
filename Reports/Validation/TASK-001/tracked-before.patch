-    /// Ye aapko aapka final survival time batati hai.
-    /// </summary>
-    public class GameOverUI : MonoBehaviour
-    {
-        [SerializeField] private GameObject _gameOverPanel;
-        [SerializeField] private TextMeshProUGUI _survivalTimeText;
