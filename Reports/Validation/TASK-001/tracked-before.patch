-                
-                Vector3 spawnPos = _firePoint != null ? _firePoint.position : transform.position;
-                Instantiate(_projectilePrefab, spawnPos, rotation);
-                
-                Debug.Log("[WandWeapon] Fired projectile at enemy!");
-            }
-        }
-    }
-}
